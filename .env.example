# =============================================================================
# sema-chatbot — variáveis de ambiente
# Copie para .env.local e preencha. NUNCA versione valores reais.
# Validação: src/lib/env.js (Zod). Variáveis (obrigatória) vazias impedem
# a aplicação de funcionar.
# =============================================================================

# -----------------------------------------------------------------------------
# PÚBLICAS (NEXT_PUBLIC_*) — vão para o navegador. Nunca coloque segredos aqui.
# -----------------------------------------------------------------------------

# (obrigatória) URL base do site. Usada no link do login por e-mail (magic link).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# (obrigatória) URL do projeto Supabase. Painel > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=

# (obrigatória) Chave pública do Supabase ("sb_publishable_...").
# Projetos antigos podem usar a "anon key" aqui.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# (obrigatória) Site key do Cloudflare Turnstile.
# Chave de teste "sempre passa" da Cloudflare: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# -----------------------------------------------------------------------------
# SERVIDOR — segredos. Lidas só no servidor, via getServerEnv().
# -----------------------------------------------------------------------------

# (obrigatória) Chave secreta do Supabase ("sb_secret_..." ou a antiga
# "service_role"). Ignora RLS: use somente em código de servidor.
SUPABASE_SECRET_KEY=

# (opcional, padrão: fontes) Bucket do Supabase Storage para PDFs e DOCX enviados.
SUPABASE_STORAGE_BUCKET=fontes

# (obrigatória) Chave da API do Google AI Studio (Gemini): chat e embeddings.
GOOGLE_GENERATIVE_AI_API_KEY=

# (opcional, padrão: gemini-2.5-flash) Modelo de chat do Google.
GOOGLE_CHAT_MODEL=

# (opcional, padrão: gemini-embedding-001) Modelo de embeddings do Google.
GOOGLE_EMBEDDING_MODEL=

# (opcional, padrão: 768) Dimensão dos vetores. Deve ser igual à coluna
# vector(N) do pgvector no banco.
EMBEDDING_DIMENSIONS=768

# (opcional) Chave da Groq. Se vazia, o fallback de LLM fica desligado.
GROQ_API_KEY=

# (opcional, padrão: llama-3.3-70b-versatile) Modelo de chat da Groq.
GROQ_CHAT_MODEL=

# (obrigatória) Secret key do Cloudflare Turnstile.
# Chave de teste "sempre passa": 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=

# (opcional, padrão: 10) Perguntas por minuto por visitante no chat público.
CHAT_RATE_LIMIT_PER_MINUTE=10

# (opcional, padrão: 1000) Tamanho máximo de uma pergunta, em caracteres.
CHAT_MAX_QUESTION_CHARS=1000

# -----------------------------------------------------------------------------
# FERRAMENTAS — não usadas pelo app (não validadas em src/lib/env.js).
# Lidas pelo Supabase CLI e pelo `npm run secrets:sync`.
# -----------------------------------------------------------------------------

# Senha do banco do projeto Supabase.
SUPABASE_DB_PASSWORD=

# Token pessoal do Supabase (supabase.com > Account preferences > Access Tokens).
SUPABASE_ACCESS_TOKEN=
